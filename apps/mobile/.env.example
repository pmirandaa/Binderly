# =========================================================================
# Binderly Mobile — example environment file (Expo-prefixed).
#
# Copy to `.env.local` and fill in real values. Expo's bundler ONLY
# inlines variables prefixed with `EXPO_PUBLIC_*` into the JS bundle
# at build time; everything else is unavailable at runtime in the
# native binary. The root `.env.example` documents the canonical
# `MOBILE_*` triple used elsewhere in the repo (see
# `context/secrets-and-env.md`); the values here are the
# Expo-readable mirrors.
#
# ALL keys below are public-by-design. The Supabase anon key is
# safe to ship to clients (it's the entry point Supabase Auth + RLS
# guard). Real secrets (service-role key, RevenueCat secret) NEVER
# appear in EXPO_PUBLIC_*.
# =========================================================================

# Base URL for the Binderly backend. Defaults to the local Supabase
# CLI stack. Override to your project URL in dev / prod
# (https://<project-ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key. Public-by-design. Pull from `supabase status`
# locally, or from the Supabase dashboard for cloud projects.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional override — set when the API host differs from the
# Supabase URL (e.g. a Cloudflare Worker reverse-proxy in front of
# Edge Functions). When unset, EXPO_PUBLIC_SUPABASE_URL is used.
# EXPO_PUBLIC_API_URL=

# Optional: TCGplayer affiliate program ID (issued by Impact when
# our affiliate application is approved). When unset, the
# "Buy on TCGplayer" CTA on the card detail screen renders as a
# disabled "Coming soon" button — the build does not fail. Set in
# EAS Secrets for production builds to enable click-through.
# EXPO_PUBLIC_TCGPLAYER_AFFILIATE_ID=

# Optional: RevenueCat SDK public API keys (one per store). Issued
# by the RevenueCat dashboard under Project → API keys. Public-by-
# design: these scope to a single app/platform and are safe to ship
# in the JS bundle. The native SDK uses them to identify the app
# when talking to RevenueCat's backend; receipt validation happens
# server-side and never trusts the client.
#
# When BOTH are unset, the mobile billing module emits a single
# console.warn at first use and returns a "free tier, no
# entitlements" stub adapter so the app keeps running for
# contributors without a RevenueCat account. Offerings resolve to
# the `null` sentinel; useEntitlementsQuery() resolves to
# `{ tier: 'free', activeEntitlements: {} }`. Set both in EAS
# Secrets for production builds.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# OAuth provider configuration is owned by the Supabase project
# (see infra/supabase/config.toml + the provider docs under
# infra/supabase/auth/). The mobile client only needs the deep-link
# scheme registered in app.json (`binderly://`). Apple Sign-In on
# iOS additionally requires the bundle to be signed with an Apple
# Developer team ID that has the "Sign in with Apple" capability;
# that is configured via EAS, not env.
