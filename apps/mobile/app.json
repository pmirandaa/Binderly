{
  "expo": {
    "name": "Binderly",
    "slug": "binderly",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "binderly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.binderly.binderly",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:binderly.app"]
    },
    "android": {
      "package": "app.binderly.binderly",
      "adaptiveIcon": {
        "backgroundColor": "#0FA3A3"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0FA3A3",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
