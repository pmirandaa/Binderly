{
  "expo": {
    "name": "Binderly",
    "slug": "binderly",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "binderly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.binderly.binderly",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:binderly.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "Binderly needs your camera to scan Pokémon cards and add them to your collection. Card images stay on your phone — they never leave the device."
      }
    },
    "android": {
      "package": "app.binderly.binderly",
      "adaptiveIcon": {
        "backgroundColor": "#0FA3A3"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0FA3A3",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Binderly needs your camera to scan Pokémon cards and add them to your collection. Card images stay on your phone — they never leave the device.",
          "enableMicrophonePermission": false,
          "enableLocation": false,
          "enableCodeScanner": false,
          "enableFrameProcessors": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
