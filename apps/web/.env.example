# @binderly/web — env template
#
# Copy this file to `.env.local` and fill in real values. Defaults
# below target the local Supabase stack started by
# `pnpm db:start` from the repo root. Only `NEXT_PUBLIC_SUPABASE_*`
# are required for the dev build to succeed.

# Backend API base URL (Supabase project URL or a reverse-proxy
# host in front of Edge Functions).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key — public-by-design. The anon key the local
# Supabase CLI prints on `pnpm db:start`. Replace with your
# project's anon key in production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional: image CDN host. R2-backed bucket in production.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=http://localhost:9000/images

# Optional: self URL used for OG meta tags + auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: TCGplayer affiliate program ID (issued by Impact when
# our affiliate application is approved). When unset, the
# "Buy on TCGplayer" CTA on card detail renders as a disabled
# "Coming soon" button — the build does not fail. Set this in
# production (Vercel project env) to enable click-through.
# NEXT_PUBLIC_TCGPLAYER_AFFILIATE_ID=

# OAuth providers (Google / Apple / Discord) are configured on
# the Supabase project itself (Authentication → Providers in
# the Supabase dashboard, or `infra/supabase/auth/*.md` for the
# managed config). The web app does NOT take provider
# client-IDs / secrets via env: the Supabase auth server holds
# them, and `signInWithOAuth({ provider })` redirects through
# Supabase, which then redirects to the provider. The only
# auth-related env var the client needs is
# NEXT_PUBLIC_APP_URL above (used to build the OAuth/magic-link
# redirectTo URL pointing at `/auth/callback`).
