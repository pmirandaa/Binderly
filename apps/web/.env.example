# @binderly/web — env template
#
# Copy this file to `.env.local` and fill in real values. Defaults
# below target the local Supabase stack started by
# `pnpm db:start` from the repo root. Only `NEXT_PUBLIC_SUPABASE_*`
# are required for the dev build to succeed.

# Backend API base URL (Supabase project URL or a reverse-proxy
# host in front of Edge Functions).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key — public-by-design. The anon key the local
# Supabase CLI prints on `pnpm db:start`. Replace with your
# project's anon key in production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional: image CDN host. R2-backed bucket in production.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=http://localhost:9000/images

# Optional: self URL used for OG meta tags + auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: TCGplayer affiliate program ID (issued by Impact when
# our affiliate application is approved). When unset, the
# "Buy on TCGplayer" CTA on card detail renders as a disabled
# "Coming soon" button — the build does not fail. Set this in
# production (Vercel project env) to enable click-through.
# NEXT_PUBLIC_TCGPLAYER_AFFILIATE_ID=

# OAuth providers (Google / Apple / Discord) are configured on
# the Supabase project itself (Authentication → Providers in
# the Supabase dashboard, or `infra/supabase/auth/*.md` for the
# managed config). The web app does NOT take provider
# client-IDs / secrets via env: the Supabase auth server holds
# them, and `signInWithOAuth({ provider })` redirects through
# Supabase, which then redirects to the provider. The only
# auth-related env var the client needs is
# NEXT_PUBLIC_APP_URL above (used to build the OAuth/magic-link
# redirectTo URL pointing at `/auth/callback`).

# ---------------------------------------------------------------------
# Paddle Billing (Merchant of Record) + RevenueCat (entitlements)
# ---------------------------------------------------------------------
#
# Pablo is in Chile, where Stripe doesn't onboard sellers. Paddle is
# our Merchant of Record — Paddle invoices the customer (handling
# global VAT / sales tax), pays out to Pablo, and emits a webhook on
# every subscription/transaction event. We forward those events to
# RevenueCat (the unified entitlement source for both web + mobile).
#
# All keys below are OPTIONAL during development: the `/billing` page
# renders a friendly "Billing isn't configured in this environment"
# placeholder when `NEXT_PUBLIC_PADDLE_CLIENT_TOKEN` is absent, and
# the `/api/paddle/webhook` endpoint returns 503 when
# `PADDLE_WEBHOOK_SECRET` is absent — neither will crash the build.

# Paddle environment — `sandbox` (test mode) or `production`. Defaults
# to `sandbox` if unset.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Public client token from the Paddle dashboard. Safe to ship to the
# browser bundle. Required for Paddle.js to initialize the overlay.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Public price ids (per Paddle dashboard → Catalog → Prices). Can be
# left blank in dev — the corresponding plan card is then disabled
# with a "price not configured" hint. Sandbox + production deploys
# need different price ids (Paddle scopes them per environment).
# NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
# NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=

# Server-side Paddle credentials. Never prefix with NEXT_PUBLIC_.
# `PADDLE_VENDOR_ID` is informational (logged for debugging);
# `PADDLE_API_KEY` is reserved for future server-to-Paddle calls
# (e.g. price preview, refund initiation); `PADDLE_WEBHOOK_SECRET`
# is mandatory for the webhook route to verify HMAC signatures.
# PADDLE_VENDOR_ID=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=

# RevenueCat REST API secret key (server-only). Used by the webhook
# route to grant/revoke promotional entitlements server-side. The
# convention is `pro` for the entitlement id (kept in sync with
# `apps/web/lib/paddle/plans.ts` PRO_ENTITLEMENT_ID and the mobile
# app's `apps/mobile/src/billing/entitlements.ts`).
# REVENUECAT_API_KEY=

# Optional override for the RevenueCat REST base URL. Defaults to
# `https://api.revenuecat.com`. Tests + offline development can
# point this at a local mock.
# REVENUECAT_API_BASE_URL=

# Supabase service-role key — used by the Paddle webhook route to
# write audit rows to `paddle_webhook_log`. Never ship to the
# client; the webhook is a Node.js route handler.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
