# @binderly/web — env template
#
# Copy this file to `.env.local` and fill in real values. Defaults
# below target the local Supabase stack started by
# `pnpm db:start` from the repo root. Only `NEXT_PUBLIC_SUPABASE_*`
# are required for the dev build to succeed.

# Backend API base URL (Supabase project URL or a reverse-proxy
# host in front of Edge Functions).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key — public-by-design. The anon key the local
# Supabase CLI prints on `pnpm db:start`. Replace with your
# project's anon key in production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional: image CDN host. R2-backed bucket in production.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=http://localhost:9000/images

# Optional: self URL used for OG meta tags + auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
