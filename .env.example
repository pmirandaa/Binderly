# =========================================================================
# Binderly — example environment file (canonical, scoped).
#
# Copy to `.env` (loaded by Compose) or `.env.local` (per-developer
# overrides) and fill in real secrets where the line is tagged
# `# REQUIRED`. The defaults below are wired to the local development
# stacks brought up by:
#
#   - `infra/docker-compose.yml`  → Postgres (5433) + MinIO (9000/9001)
#                                   + Mailpit (1025/8025)
#   - `infra/supabase/`           → Supabase CLI (54321/54322/54323/54324)
#
# All values shipped with this file are DEV-ONLY placeholders that are
# safe to commit. Real secrets ship empty with a `# REQUIRED` marker.
#
# Reference: see `docs/env.md` for what every var is for, where to get a
# real value, and which scope owns it. Naming convention is documented
# at `context/secrets-and-env.md` and follows `<SCOPE>_<SERVICE>_<NAME>`.
# Sections below are organized in that scope order:
#   STACK → DERIVED → SUPABASE LOCAL → AUTH PROVIDERS →
#   WEB → MOBILE → API_PYTHON → PIPELINE → EDGE → CI → FEATURE FLAGS
# =========================================================================


# =========================================================================
# ===== STACK =====
# Docker Compose stack — `infra/docker-compose.yml`. Dev-only credentials
# baked into the compose file; override here only to dodge a port
# collision on your box. These are infrastructure-level and therefore
# unscoped (no leading `WEB_` / `API_PYTHON_` / etc.).
# =========================================================================
POSTGRES_USER=binderly
POSTGRES_PASSWORD=binderly
POSTGRES_DB=binderly
POSTGRES_PORT=5433

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniominio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025


# =========================================================================
# ===== DERIVED URLS =====
# Convenience URLs derived from the STACK values above. Apps and
# migrations read these directly so a port override only needs to happen
# in one place. Override these too if you remap the underlying ports.
# =========================================================================

# DUAL-POSTGRES NOTE: DATABASE_URL (port 5433) is the binderly Compose
# stack used by data-pipeline workflows. SUPABASE_DB_URL below
# (port 54322) is the Supabase CLI stack — used by app-side code
# (web, mobile, edge functions). The two databases do NOT share data;
# the app schema lives only on Supabase.
DATABASE_URL=postgresql://binderly:binderly@localhost:5433/binderly

SMTP_HOST=localhost
SMTP_PORT=1025

# S3-style endpoint for the local MinIO. Use path-style addressing
# (`http://localhost:9000/<bucket>`) — virtual-host style is not wired
# up in dev.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1


# =========================================================================
# ===== SUPABASE LOCAL =====
# Supabase CLI's local stack — see infra/supabase/ and the README there.
# Brought up via `pnpm db:start`, torn down via `pnpm db:stop`.
#
# DEV ONLY — do NOT use these keys or this URL in production. The anon
# and service-role keys below are well-known dev defaults baked into
# the Supabase CLI's local stack (same on every developer's box). Real
# keys come from Supabase Cloud and live in `.env.local`. Run
# `supabase status --workdir infra` to print the live values locally.
# =========================================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU


# =========================================================================
# ===== AUTH PROVIDERS =====
# OAuth provider secrets and Studio extras consumed by
# `infra/supabase/config.toml` via env(...) substitution. Empty in dev
# — providers will appear configured in Studio but real OAuth
# round-trips fail until these are filled in `.env.local`.
# NEVER commit real values here.
# =========================================================================
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=                  # REQUIRED for real Google OAuth
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=                   # REQUIRED for real Apple OAuth (signed JWT)
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=                 # REQUIRED for real Discord OAuth

# Optional: powers the AI assistant inside Supabase Studio. Leave empty
# to disable. Not used by app code.
OPENAI_API_KEY=


# =========================================================================
# ===== WEB =====
# Next.js web app — apps/web. Dev defaults assume the local Supabase CLI
# stack and the local MinIO bucket (path-style). Real Supabase project
# values come from your personal `.env.local` once you wire a real
# Supabase project.
# =========================================================================
WEB_SUPABASE_URL=http://localhost:54321
WEB_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
WEB_R2_PUBLIC_BASE_URL=http://localhost:9000/images
WEB_POSTHOG_KEY=                                       # REQUIRED for real analytics (leave empty in dev)
WEB_SENTRY_DSN=                                        # REQUIRED for real error reporting (leave empty in dev)
WEB_PADDLE_CLIENT_TOKEN=                               # REQUIRED for checkout (Paddle client-side token)
WEB_PADDLE_API_KEY=                                    # REQUIRED for server-side Paddle calls (server-only)
WEB_PADDLE_WEBHOOK_SECRET=                             # REQUIRED for Paddle webhook signature verification
WEB_PADDLE_ENVIRONMENT=sandbox
WEB_TCGPLAYER_AFFILIATE_ID=                            # REQUIRED in prod (TCGplayer Impact affiliate id)


# =========================================================================
# ===== MOBILE =====
# Expo mobile app — apps/mobile. Mirrors the WEB_* Supabase / R2
# defaults so the local Supabase stack works for both clients
# simultaneously.
# =========================================================================
MOBILE_SUPABASE_URL=http://localhost:54321
MOBILE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
MOBILE_R2_PUBLIC_BASE_URL=http://localhost:9000/images
MOBILE_POSTHOG_KEY=                                    # REQUIRED for real analytics (leave empty in dev)
MOBILE_SENTRY_DSN=                                     # REQUIRED for real error reporting (leave empty in dev)
MOBILE_REVENUECAT_API_KEY_IOS=                         # REQUIRED for iOS in-app purchases
MOBILE_REVENUECAT_API_KEY_ANDROID=                     # REQUIRED for Android in-app purchases
MOBILE_TCGPLAYER_AFFILIATE_ID=                         # REQUIRED in prod (mirror of WEB_TCGPLAYER_AFFILIATE_ID)


# =========================================================================
# ===== API_PYTHON =====
# FastAPI services — apps/api-python. Dev defaults point at the Compose
# stack (port 5433 + MinIO). These mirror the canonical names in
# context/secrets-and-env.md.
#
# DB choice: API_PYTHON_DB_URL targets the Compose Postgres because
# Python services own the data-pipeline workflows; the app schema on
# Supabase (port 54322) is reached via the Supabase service-role key,
# not via this URL.
# =========================================================================
API_PYTHON_DB_URL=postgresql://binderly:binderly@localhost:5433/binderly
API_PYTHON_R2_ACCESS_KEY_ID=minio
API_PYTHON_R2_SECRET_ACCESS_KEY=miniominio
API_PYTHON_R2_BUCKET_IMAGES=images
API_PYTHON_R2_BUCKET_MODELS=models
API_PYTHON_R2_BUCKET_ANN=ann
API_PYTHON_SENTRY_DSN=                                 # REQUIRED for real error reporting (leave empty in dev)

# Pricing aggregator — provider chosen in T-DL-PRICING-AGGREGATOR.
# Leave empty until then; PRICING_ENABLED feature flag below stays
# false until credentials are wired.
API_PYTHON_PRICING_AGGREGATOR_PROVIDER=                # REQUIRED when PRICING_ENABLED=true (e.g. poketrace, pokemon_api)
API_PYTHON_PRICING_AGGREGATOR_API_KEY=                 # REQUIRED when PRICING_ENABLED=true
API_PYTHON_PRICING_AGGREGATOR_BASE_URL=                # REQUIRED when PRICING_ENABLED=true (varies by provider)

# eBay Browse API (free tier; production app id from eBay Developer
# Program). Marketplace Insights is gated behind a separate enable flag
# until business approval lands; reuses the same Browse credentials.
API_PYTHON_EBAY_BROWSE_APP_ID=                         # REQUIRED for live eBay queries
API_PYTHON_EBAY_BROWSE_CERT_ID=                        # REQUIRED for live eBay queries
API_PYTHON_EBAY_BROWSE_DEV_ID=                         # REQUIRED for live eBay queries
API_PYTHON_EBAY_MARKETPLACE_INSIGHTS_ENABLED=false

# Legacy / additional eBay credentials placeholder — same eBay account
# but kept as separate env names for forward-compat with the eBay Sell
# / Trading APIs if/when we adopt them.
API_PYTHON_EBAY_APP_ID=                                # REQUIRED if eBay Sell/Trading APIs are wired
API_PYTHON_EBAY_CERT_ID=                               # REQUIRED if eBay Sell/Trading APIs are wired
API_PYTHON_EBAY_DEV_ID=                                # REQUIRED if eBay Sell/Trading APIs are wired

# FX provider. Default `frankfurter` is free and key-less, so dev works
# out of the box. Switch to `openexchangerates` for higher-quality
# rates (paid; needs FX_API_KEY).
API_PYTHON_FX_PROVIDER=frankfurter
API_PYTHON_FX_API_KEY=

# PSA scraper — contactable User-Agent string per PSA's robots/ToS.
# Empty in dev (no scraping); set in prod to something like
# `BinderlyBot/1.0 (+mailto:...)`.
API_PYTHON_PSA_USER_AGENT=


# =========================================================================
# ===== PIPELINE =====
# Data-pipeline TS jobs — `data-pipeline/`. No canonical PIPELINE_*
# vars exist yet; they will be added by the relevant data-source tasks
# (e.g. T-DL-SOURCE-TCGDEX-EN). The scope name is reserved here so
# subsequent tasks slot their additions in the right place.
# =========================================================================


# =========================================================================
# ===== EDGE =====
# Supabase Edge Functions. EDGE_SUPABASE_SERVICE_ROLE_KEY is provided
# automatically by the Supabase runtime in production — only set it
# locally if you're invoking edge functions outside `supabase functions
# serve`. Webhook secrets are real secrets and must be set in production.
# =========================================================================
EDGE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
EDGE_REVENUECAT_WEBHOOK_SECRET=                        # REQUIRED for RevenueCat webhook verification
EDGE_PADDLE_WEBHOOK_SECRET=                            # REQUIRED for Paddle webhook verification


# =========================================================================
# ===== CI =====
# GitHub Actions / CI tokens. Set as repository secrets in the GitHub
# UI, NOT in any local `.env.local` (the listing here is for
# discoverability and so `pnpm check:env` enforces presence in any env
# file that opts to define them locally — most developers won't).
# =========================================================================
CI_VERCEL_TOKEN=                                       # REQUIRED for Vercel deploys (CI only)
CI_FLY_API_TOKEN=                                      # REQUIRED for Fly.io deploys (CI only)
CI_EXPO_TOKEN=                                         # REQUIRED for Expo / EAS builds (CI only)
CI_SUPABASE_ACCESS_TOKEN=                              # REQUIRED for `supabase` CLI in CI
CI_SUPABASE_DB_PASSWORD=                               # REQUIRED for `supabase db push` in CI
CI_SUPABASE_PROJECT_REF=                               # REQUIRED — Supabase project ref (e.g. abcdwxyz)


# =========================================================================
# ===== FEATURE FLAGS =====
# Environment-flippable behaviour switches. Same shape across dev and
# prod; flip locally for testing. These are env vars (not constants)
# specifically so they can be flipped per environment without code
# changes.
# =========================================================================
PRICING_ENABLED=false
CLOUD_FALLBACK_RECOGNITION=false
COMMUNITY_GRADING_FLYWHEEL=false
