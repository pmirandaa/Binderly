# Binderly — example environment file.
#
# Copy to `.env` (or `.env.local`) and adjust as needed. The defaults
# below are wired to the local Docker Compose stack in
# `infra/docker-compose.yml` and are safe to commit because they are
# DEV-ONLY placeholders. Never put real secrets in this file — secret
# vars below carry a `# REQUIRED` marker and ship empty.
#
# Naming follows the `<SCOPE>_<SERVICE>_<NAME>` convention from
# context/secrets-and-env.md. Variables consumed by the Compose stack
# itself (POSTGRES_*, MINIO_*, MAILPIT_*) are unscoped because they are
# infrastructure-level, not app-level.

# -----------------------------------------------------------------------
# Docker Compose stack — infra/docker-compose.yml
# Dev-only credentials. Override locally if a port collides on your box.
# -----------------------------------------------------------------------
POSTGRES_USER=binderly
POSTGRES_PASSWORD=binderly
POSTGRES_DB=binderly
POSTGRES_PORT=5433

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniominio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# -----------------------------------------------------------------------
# Convenience URLs derived from the values above. Apps and migrations
# read these directly so a port override only needs to happen once.
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://binderly:binderly@localhost:5433/binderly

SMTP_HOST=localhost
SMTP_PORT=1025

# S3-style endpoint for the local MinIO. Use path-style addressing
# (`http://localhost:9000/<bucket>`) — virtual-host style is not wired up
# in dev.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

# -----------------------------------------------------------------------
# Python services — apps/api-python (dev defaults pointing at the
# Compose stack). These mirror the canonical names in
# context/secrets-and-env.md.
# -----------------------------------------------------------------------
API_PYTHON_DB_URL=postgresql://binderly:binderly@localhost:5433/binderly
API_PYTHON_R2_ACCESS_KEY_ID=minio
API_PYTHON_R2_SECRET_ACCESS_KEY=miniominio
API_PYTHON_R2_BUCKET_IMAGES=images
API_PYTHON_R2_BUCKET_MODELS=models
API_PYTHON_R2_BUCKET_ANN=ann

# -----------------------------------------------------------------------
# Web app — apps/web. Real Supabase project values come from your
# personal `.env.local`; these dev defaults assume a local Supabase CLI
# stack alongside Compose.
# -----------------------------------------------------------------------
WEB_SUPABASE_URL=http://localhost:54321
WEB_SUPABASE_ANON_KEY=                                  # REQUIRED — value supabase-cli prints on `supabase start`
WEB_R2_PUBLIC_BASE_URL=http://localhost:9000/images
WEB_POSTHOG_KEY=                                        # REQUIRED in real envs (leave empty in dev)
WEB_SENTRY_DSN=                                         # REQUIRED in real envs (leave empty in dev)

# -----------------------------------------------------------------------
# Feature flags. Same shape as production; flip locally for testing.
# -----------------------------------------------------------------------
PRICING_ENABLED=false
CLOUD_FALLBACK_RECOGNITION=false
COMMUNITY_GRADING_FLYWHEEL=false
