[
  {
    "AllowedOrigins": [
      "https://binderly.app",
      "https://www.binderly.app"
    ],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": ["Range", "If-Match", "If-None-Match", "If-Modified-Since"],
