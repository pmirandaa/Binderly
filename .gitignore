# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
.turbo/
.expo/
.expo-shared/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets — never commit, but keep examples
.env
.env.*
!.env.example
!.env.example.*

# OS junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.iml
.history/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version
*.egg-info/

# Embedding pipeline build artefacts (apps/api-python/embeddings).
# Production .tflite models go to R2, not into git. The test fixture
# at apps/api-python/embeddings/tests/fixtures/tiny_embedder.tflite is
# committed and is exempted by the `!` rules below.
apps/api-python/embeddings/build/
apps/api-python/embeddings/dist/
apps/api-python/embeddings/out/
apps/api-python/embeddings/**/*.npz
*.tflite
*.tflite.bin
!apps/api-python/embeddings/tests/fixtures/tiny_embedder.tflite
!apps/api-python/embeddings/tests/fixtures/tiny_embedder.manifest.json

# Mobile (Expo / EAS) — secrets and signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Generated archives
*.tgz
*.zip

# macOS Finder metadata
._*
.Spotlight-V100
.Trashes
