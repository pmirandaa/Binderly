{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@binderly/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.bench.ts",
    "src/test-fixtures.ts"
  ]
}
