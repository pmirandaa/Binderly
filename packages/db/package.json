{
  "name": "@binderly/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schemas, generated SQL migrations, and the typed Postgres client for Binderly.",
  "license": "UNLICENSED",
  "type": "module",
  "prettier": "@binderly/prettier-config",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"@binderly/db: no tests yet\" && exit 0",
    "db:generate": "tsx scripts/generate.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@binderly/eslint-config": "workspace:*",
    "@binderly/prettier-config": "workspace:*",
    "@binderly/tsconfig": "workspace:*",
    "@types/node": "22.19.17",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
