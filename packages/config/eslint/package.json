{
  "name": "@binderly/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configurations for the Binderly monorepo.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./node": "./node.js",
    "./react": "./react.js",
    "./next": "./next.js",
    "./react-native": "./react-native.js"
  },
  "files": [
    "index.js",
    "node.js",
    "react.js",
    "next.js",
    "react-native.js",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --check --config ../prettier/index.js ."
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.4",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.5.0",
    "typescript-eslint": "8.59.1"
  },
  "peerDependencies": {
    "eslint": "9.39.4",
    "prettier": "3.8.3"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "prettier": "3.8.3"
  }
}
