{
  "name": "@binderly/tsconfig",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Shared TypeScript configuration presets for the Binderly monorepo.",
  "files": [
    "base.json",
    "node.json",
    "next.json",
    "react-native.json",
    "library.json",
    "README.md"
  ],
  "scripts": {
    "test:base": "tsc --noEmit -p base.json",
    "test:node": "tsc --noEmit -p node.json",
    "test:next": "tsc --noEmit -p next.json",
    "test:react-native": "tsc --noEmit -p react-native.json",
    "test:library": "tsc --noEmit -p library.json",
    "test:unchecked-fail": "bash __test__/unchecked-must-fail.sh",
    "test": "pnpm run test:base && pnpm run test:node && pnpm run test:next && pnpm run test:react-native && pnpm run test:library && pnpm run test:unchecked-fail",
    "typecheck": "pnpm run test"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "6.0.3"
  }
}
