{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@binderly/tsconfig/next",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["__test__/next.example.ts"]
}
