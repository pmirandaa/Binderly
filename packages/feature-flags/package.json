{
  "name": "@binderly/feature-flags",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic free/pro gating decision core (PROJECT.md § 16). Built on @binderly/entitlements' pure helpers; turns a resolved entitlement + a paid feature (or a count-limited resource) into an allow/block GateResult with a typed upgrade reason. No React/RN dependency — web and mobile wrap it with their own hooks + <Gate>/<UpgradePrompt>.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "prettier": "@binderly/prettier-config",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@binderly/entitlements": "workspace:*"
  },
  "devDependencies": {
    "@binderly/eslint-config": "workspace:*",
    "@binderly/prettier-config": "workspace:*",
    "@binderly/tsconfig": "workspace:*",
    "@types/node": "22.19.17",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
