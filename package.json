{
  "name": "binderly",
  "version": "0.0.0",
  "private": true,
  "description": "Binderly — Pokémon TCG collection tracker. Monorepo root.",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.22.2",
    "pnpm": "9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "db:start": "supabase start --workdir infra",
    "db:stop": "supabase stop --workdir infra",
    "db:reset": "supabase db reset --workdir infra",
    "db:generate": "pnpm --filter @binderly/db db:generate",
    "db:migrate": "pnpm --filter @binderly/db db:migrate",
    "db:migrate:local": "pnpm --filter @binderly/db db:migrate -- --url $SUPABASE_DB_URL",
    "check:env": "bash scripts/check-env.sh .env.local"
  },
  "devDependencies": {
    "supabase": "2.98.1",
    "turbo": "2.9.6"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.76.9",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.28",
      "@types/react-dom": "18.3.7"
    }
  }
}
